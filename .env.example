# =====================================================
# AI测试平台 - 环境配置模板
# =====================================================
# ⚠️  重要提示：
# 1. 复制此文件为 .env 并填写真实配置
# 2. 绝对不要将包含敏感信息的 .env 文件提交到版本控制
# 3. 生产环境必须使用强随机密钥
# 4. 定期轮换API密钥和数据库密码

# ==================== 环境配置 ====================
ENVIRONMENT=dev
APP_NAME=AI测试平台
APP_VERSION=1.0.0
DEBUG=true

# ==================== 管理员配置 ====================
# 初始管理员密码（生产环境必须设置，否则自动生成随机密码）
ADMIN_INITIAL_PASSWORD=

# ==================== 数据库配置 ====================
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/ai_testmaster
DATABASE_URL_SLAVE=
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=10

# ==================== Redis配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ==================== JWT配置 ====================
# ⚠️  生产环境必须使用强随机密钥！
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 加密配置 ====================
# ⚠️  生产环境必须设置加密密钥！
ENCRYPTION_KEY=your-encryption-key-here
ENCRYPTION_SALT=your-encryption-salt-here

# ==================== DeepSeek API配置 ====================
# 获取API密钥: https://platform.deepseek.com/
# ⚠️  如果此密钥已泄露，请立即到平台轮换新密钥
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# ==================== 视觉模型配置（AI视觉识别） ====================
# 支持多模型动态切换，只需配置要使用的模型即可
# 可选模型: kimi, qwen, zhipu, baidu, doubao, mimo

# 默认使用的视觉模型
VISION_MODEL_DEFAULT=mimo

# -------------------- Kimi (Moonshot) --------------------
# 获取API Key: https://platform.moonshot.cn/
KIMI_API_KEY=your-kimi-api-key-here
KIMI_MODEL=moonshot-v1-128k-vision-preview

# -------------------- 通义千问 (阿里云) --------------------
# 获取API Key: https://dashscope.aliyun.com/
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen3-vl-flash

# -------------------- 智谱GLM (可选) --------------------
# 获取API Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_MODEL=glm-4v-plus

# -------------------- 文心一言 (可选) --------------------
# 获取API Key: https://console.bce.baidu.com/
BAIDU_API_KEY=your-baidu-api-key-here
BAIDU_MODEL=ernie-bot-4

# -------------------- 豆包 (可选) --------------------
# 获取API Key: https://console.volcengine.com/
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_MODEL=doubao-vision-pro-32k

# -------------------- MiMo (小米) --------------------
# 获取API Key: https://xiaomimimo.com/
# 按量付费: https://api.xiaomimimo.com/v1
# Token Plan: https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=your-mimo-api-key-here
MIMO_MODEL=mimo-v2.5
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# ==================== AI自愈配置 ====================
# 元素定位失败时启用AI自愈兜底
AI_SELF_HEALING_ENABLED=true
# 自愈最大重试次数
AI_SELF_HEALING_MAX_RETRIES=1
# Stagehand使用的AI模型（需配置Browserbase时生效）
STAGEHAND_MODEL=gpt-4o
# Browserbase云浏览器配置（可选，不配置则使用本地AI自愈）
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ==================== Celery配置 ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=false

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=docx,doc,pdf,xlsx,xls,csv,txt,md,png,jpg,jpeg,gif,webp,figma,url,yaml,yml,json,zip,rar

# ==================== CORS配置 ====================
# 开发环境可以使用 *，生产环境必须指定具体域名
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
